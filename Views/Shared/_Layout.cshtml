<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeLeaveManagement</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeLeaveManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar navbar navbar-expand-lg">
        <div class="container-fluid px-4">
            <a class="navbar-brand brand-name" asp-controller="Leave" asp-action="Index">ELMS</a>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <span class="material-symbols-outlined text-secondary">notifications</span>
                <div class="profile-chip"><span class="avatar">JD</span><span><strong>John Doe</strong><small>Manager</small></span></div>
            </div>
        </div>
    </header>

    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-heading">Workspace Modules</div>
            <nav class="nav flex-column gap-1">
                <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="Index" aria-disabled="true"><span class="material-symbols-outlined">person</span>My Leave</a>
                <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="Index" aria-disabled="true"><span class="material-symbols-outlined">task_alt</span>Approvals <span class="badge rounded-pill text-bg-danger ms-auto">4</span></a>
            </nav>
        </aside>
        <main class="main-content">
            <div class="content-container">
                @if (TempData["SuccessMessage"] is string message)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EmployeeLeaveManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
